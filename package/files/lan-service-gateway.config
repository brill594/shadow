config service 'main'
	option enabled '0'
	option lan_network 'lan'
	option wan_network 'wwan'

# One section per allowed LocalSend device. The IP must stay assigned to that
# device; assign a fixed DHCP lease before enabling a mapping.
# config localsend
#	option ip '192.168.8.167'
#	option port '53317'
#	option proxy_port '55001'
#	option fingerprint '-'

